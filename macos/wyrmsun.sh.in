#!/bin/bash

# macOS launch script for Wyrmsun
# Looks for wyrmgus in common macOS locations

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Check if we're running from an app bundle
if [ -d "$SCRIPT_DIR/../Resources" ]; then
    DATA_DIR="$SCRIPT_DIR/../Resources"
else
    DATA_DIR="@CMAKE_INSTALL_PREFIX@/@DATA_DIR@"
fi

# Function to show error dialog on macOS
show_error_dialog() {
    /usr/bin/osascript -e 'display dialog "The Wyrmgus game engine was not found.

Wyrmsun requires Wyrmgus to run. Please download and install Wyrmgus from:

https://github.com/Andrettin/Wyrmgus" with title "Wyrmsun - Engine Not Found" with icon stop buttons {"Open Download Page", "Cancel"} default button "Open Download Page"' -e 'if button returned of result is "Open Download Page" then' -e 'open location "https://github.com/Andrettin/Wyrmgus/releases"' -e 'end if' 2>/dev/null
}

# Expand $HOME since it may not be set in app bundle context
USER_HOME="$HOME"
if [ -z "$USER_HOME" ]; then
    USER_HOME=$(dscl . -read /Users/$(whoami) NFSHomeDirectory | awk '{print $2}')
fi

# Try to find wyrmgus in various locations
WYRMGUS=""

if [ -x "/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus" ]; then
    WYRMGUS="/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus"
elif [ -x "/usr/local/bin/wyrmgus" ]; then
    WYRMGUS="/usr/local/bin/wyrmgus"
elif [ -x "/opt/homebrew/bin/wyrmgus" ]; then
    WYRMGUS="/opt/homebrew/bin/wyrmgus"
elif [ -x "$USER_HOME/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus" ]; then
    WYRMGUS="$USER_HOME/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus"
elif [ -x "/usr/bin/wyrmgus" ]; then
    WYRMGUS="/usr/bin/wyrmgus"
fi

# If not found in known locations, try PATH
if [ -z "$WYRMGUS" ]; then
    WYRMGUS=$(which wyrmgus 2>/dev/null)
fi

# Show error if wyrmgus not found
if [ -z "$WYRMGUS" ] || [ ! -x "$WYRMGUS" ]; then
    show_error_dialog
    exit 1
fi

exec "$WYRMGUS" -d "$DATA_DIR" "$@"
