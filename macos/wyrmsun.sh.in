#!/bin/sh

# macOS launch script for Wyrmsun
# Looks for wyrmgus in common macOS locations

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Check if we're running from an app bundle
if [ -d "$SCRIPT_DIR/../Resources" ]; then
    DATA_DIR="$SCRIPT_DIR/../Resources"
else
    DATA_DIR="@CMAKE_INSTALL_PREFIX@/@DATA_DIR@"
fi

# Function to show error dialog on macOS
show_error_dialog() {
    osascript <<'APPLESCRIPT'
        set dialogResult to display dialog "The Wyrmgus game engine was not found.\n\nWyrmsun requires Wyrmgus to run. Please download and install Wyrmgus from:\n\nhttps://github.com/Andrettin/Wyrmgus" \
            with title "Wyrmsun - Engine Not Found" \
            with icon stop \
            buttons {"Open Download Page", "Cancel"} \
            default button "Open Download Page"

        if button returned of dialogResult is "Open Download Page" then
            open location "https://github.com/Andrettin/Wyrmgus/releases"
        end if
APPLESCRIPT
}

# Try to find wyrmgus in various locations
if [ -x "/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus" ]; then
    WYRMGUS="/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus"
elif [ -x "/usr/local/bin/wyrmgus" ]; then
    WYRMGUS="/usr/local/bin/wyrmgus"
elif [ -x "/opt/homebrew/bin/wyrmgus" ]; then
    WYRMGUS="/opt/homebrew/bin/wyrmgus"
elif [ -x "$HOME/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus" ]; then
    WYRMGUS="$HOME/Applications/Wyrmgus.app/Contents/MacOS/wyrmgus"
elif command -v wyrmgus >/dev/null 2>&1; then
    WYRMGUS="wyrmgus"
else
    show_error_dialog
    exit 1
fi

exec "$WYRMGUS" -d "$DATA_DIR" "$@"
